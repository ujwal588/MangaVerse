{
  "manifest_version": 3,
  "name": "MangaVerse — Manga Reading Companion",
  "version": "1.0.0",
  "description": "Unified tracking, smart progress, binge alerts, and reader enhancements across manga reading websites.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MangaVerse Companion"
  },
  "options_page": "src/dashboard/index.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.mangadex.org/*",
        "*://mangadex.org/*"
      ],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/hud/ReaderHUD.css",
        "icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
