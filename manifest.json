{
  "manifest_version": 3,
  "name": "MangaVerse - Manga Reading Companion",
  "version": "1.0.0",
  "description": "Unified tracking, smart progress, binge alerts, and reader enhancements across manga reading websites.",
  "icons": {
    "16": "dist/icons/icon16.png",
    "32": "dist/icons/icon32.png",
    "48": "dist/icons/icon48.png",
    "128": "dist/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "offscreen",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "dist/src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/src/popup/index.html",
    "default_icon": {
      "16": "dist/icons/icon16.png",
      "32": "dist/icons/icon32.png",
      "48": "dist/icons/icon48.png",
      "128": "dist/icons/icon128.png"
    },
    "default_title": "MangaVerse Companion"
  },
  "options_page": "dist/src/dashboard/index.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.webtoons.com/*",
        "*://webtoons.com/*",
        "*://*.mangadex.org/*",
        "*://mangadex.org/*",
        "*://*.mangakakalot.com/*",
        "*://*.chapmanganato.to/*",
        "*://*.manganato.com/*",
        "*://*.asuracomic.net/*",
        "*://*.asurascans.com/*",
        "*://*.reaperscans.com/*",
        "*://*.flamecomics.xyz/*",
        "*://*.flamecomics.me/*",
        "*://*.rawkuma.net/*"
      ],
      "js": ["dist/src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/src/content/hud/ReaderHUD.css",
        "dist/icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
